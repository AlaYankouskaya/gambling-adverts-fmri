      <Param name="conditions" updates="None" val="[{'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G1_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G2_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G3_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G4_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G5_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G6_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G7_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G8_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G9_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/G10_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'GAM', 'Description': 'optinal', 'Correct_answer': 1}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N1_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N2_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N3_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N4_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N5_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N6_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N7_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N8_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N9_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}, {'DV': 'EPI', 'arousing_stimulus': 'POS_stimuli/Background.jpeg', 'video': 'Videos/N10_20sec.mp4', 'statement': 'How did this advert make you feel?', 'Valence': 'COM', 'Description': 'optinal', 'Correct_answer': 2}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="LoopTemplate_MRI_RUN3.xlsx" valType="file"/>
